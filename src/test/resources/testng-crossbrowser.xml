<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Cross-Browser Suite" parallel="tests" thread-count="3" verbose="1">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="com.automation.listeners.AllureBrowserListener"/>
    </listeners>

    <test name="Chromium">
        <parameter name="browser" value="chromium"/>
        <groups><run><include name="ui"/></run></groups>
        <classes>
            <class name="com.automation.tests.ui.LoginTest"/>
            <class name="com.automation.tests.ui.InventoryTest"/>
            <class name="com.automation.tests.ui.CheckoutTest"/>
        </classes>
    </test>

    <test name="Firefox">
        <parameter name="browser" value="firefox"/>
        <groups><run><include name="ui"/></run></groups>
        <classes>
            <class name="com.automation.tests.ui.LoginTest"/>
            <class name="com.automation.tests.ui.InventoryTest"/>
            <class name="com.automation.tests.ui.CheckoutTest"/>
        </classes>
    </test>

    <test name="WebKit">
        <parameter name="browser" value="webkit"/>
        <groups><run><include name="ui"/></run></groups>
        <classes>
            <class name="com.automation.tests.ui.LoginTest"/>
            <class name="com.automation.tests.ui.InventoryTest"/>
            <class name="com.automation.tests.ui.CheckoutTest"/>
        </classes>
    </test>

</suite>
