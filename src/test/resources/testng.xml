<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Automation Test Suite" verbose="1" parallel="false">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <test name="UI Tests - SauceDemo">
        <groups>
            <run>
                <include name="ui"/>
            </run>
        </groups>
        <classes>
            <class name="com.automation.tests.ui.LoginTest"/>
            <class name="com.automation.tests.ui.InventoryTest"/>
            <class name="com.automation.tests.ui.CheckoutTest"/>
        </classes>
    </test>

    <test name="API Tests - JSONPlaceholder">
        <groups>
            <run>
                <include name="api"/>
            </run>
        </groups>
        <classes>
            <class name="com.automation.tests.api.UserApiTest"/>
        </classes>
    </test>

</suite>
